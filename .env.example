# Database Configuration
# PostgreSQL Docker settings
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Database URL for Docker environment (uses container name 'db' as host)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Database URL for local development (uncomment when developing locally)
# DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/your_db_name

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Your Project Name
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:8000", "http://localhost:3000", "http://localhost:8080"]

# Security
# Generate a secure secret key (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First Superuser
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_this_password
FIRST_SUPERUSER_NAME=Admin

# Email Settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.your-email-provider.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Your Project Name

# Development Settings
DEBUG=True
ENVIRONMENT=development

# Note: Replace all placeholder values with actual values in your .env file
# DO NOT commit the actual .env file to version control

